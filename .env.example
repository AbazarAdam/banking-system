# ─────────────────────────────────────────────────────────────────────────────
# Backend environment variables
# Copy this file to .env and source it before running the JAR, OR set these
# as environment variables in your hosting platform.
# ─────────────────────────────────────────────────────────────────────────────

# MySQL connection settings
DB_URL=jdbc:mysql://localhost:3306/banking_db?useSSL=false&serverTimezone=UTC
DB_USERNAME=root
DB_PASSWORD=replace-me

# Gmail SMTP credentials (use an App Password, not your account password)
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password

# JWT secret — use a long random string in production (at least 64 characters)
JWT_SECRET=replace-me-with-a-long-random-secret-key

# Allowed frontend origin for CORS
ALLOWED_ORIGIN=http://localhost:5173
